# ==============================================================================
# Nearby Wells Intelligence System (NWIS) - Backend Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL / PostGIS - Step 3)
DATABASE_URL=postgresql://user:password@localhost:5432/nwis_db?schema=public

# Authentication & Security (Step 4)
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Comma-separated list of trusted frontend origins for CORS/CSRF (e.g. http://localhost:3000,https://app.nwis.gov.in)
TRUSTED_ORIGINS=http://localhost:3000

# AI/ML Microservice Integration (Step 8)
AI_ML_SERVICE_URL=http://localhost:8000
AI_ML_SERVICE_TOKEN=your_internal_service_token_here

# Document & Object Storage (Step 6)
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_MB=25

# Telemetry Machine Ingestion (Step 10)
# Minimum 16 characters secret API key for machine-to-backend telemetry ingestion
TELEMETRY_API_KEY=dev_telemetry_secret_key_16_chars_min

