NODE_ENV=development
PORT=5000
API_PREFIX=/api
LOG_LEVEL=info
CORS_ORIGIN=*
DATABASE_URL="postgresql://username:password@localhost:5432/sih26034_db?schema=public"
JWT_SECRET=your-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1d

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=inspection-images
MAX_FILE_SIZE_MB=10

# OCR Integration Layer Configuration
# OCR_PROVIDER can be 'mock' (default) or 'http' (for production AI/ML service)
OCR_PROVIDER=mock
OCR_SERVICE_URL=https://ai-ocr-service.internal/ocr
OCR_SERVICE_API_KEY=your-ocr-service-api-key
OCR_TIMEOUT_MS=30000

