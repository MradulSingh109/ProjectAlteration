// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal infrastructure model to verify PostgreSQL connectivity and schema migrations
model DatabaseHealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("healthy")
  checkedAt DateTime @default(now())

  @@map("database_health_checks")
}

/// Role-based access control roles for PS 121
enum Role {
  ADMIN
  DRILLING_ENGINEER
  GEOLOGIST
  VIEWER
}

/// Core User entity representing authenticated domain actors
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("users")
}

/// Persistent authentication session enabling revocation and refresh security
model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  isRevoked        Boolean   @default(false) @map("is_revoked")
  expiresAt        DateTime  @map("expires_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  lastUsedAt       DateTime? @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Operational well lifecycle status
enum WellStatus {
  PLANNED
  DRILLING
  COMPLETED
  ABANDONED
}

/// Core Well master record for PS 121
model Well {
  id              String      @id @default(uuid())
  wellId          String      @unique @map("well_id")
  name            String
  field           String
  latitude        Float
  longitude       Float
  spudDate        DateTime?   @map("spud_date")
  plannedDepthMd  Decimal     @map("planned_depth_md") @db.Decimal(12, 3)
  plannedDepthTvd Decimal     @map("planned_depth_tvd") @db.Decimal(12, 3)
  status          WellStatus  @default(PLANNED)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  formations      Formation[]
  documents       Document[]

  @@index([field])
  @@index([status])
  @@index([latitude, longitude])
  @@map("wells")
}

/// Geological stratigraphy/formation interval associated with a well
model Formation {
  id        String   @id @default(uuid())
  wellId    String   @map("well_id")
  name      String
  topMd     Decimal  @map("top_md") @db.Decimal(12, 3)
  bottomMd  Decimal  @map("bottom_md") @db.Decimal(12, 3)
  lithology String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  well Well @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId])
  @@index([name])
  @@map("formations")
}

/// Historical drilling document classification for PS 121
enum DocumentType {
  WCR
  DDR
  MUD_LOG
  CEMENTING_REPORT
  WELL_SURVEY
}

/// Asynchronous document ingestion lifecycle state
enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Historical drilling and geological technical document
model Document {
  id              String          @id @default(uuid())
  wellId          String          @map("well_id")
  filename        String          @map("filename")
  documentType    DocumentType    @map("document_type")
  mimeType        String          @map("mime_type")
  fileSize        Int             @map("file_size")
  fileHash        String          @map("file_hash")
  storageKey      String          @map("storage_key")
  uploadedBy      String          @map("uploaded_by")
  uploadedAt      DateTime        @default(now()) @map("uploaded_at")
  ingestionStatus IngestionStatus @default(PENDING) @map("ingestion_status")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  well Well @relation(fields: [wellId], references: [id], onDelete: Restrict)

  @@index([wellId], name: "idx_documents_well_id")
  @@index([documentType], name: "idx_documents_type")
  @@index([ingestionStatus], name: "idx_documents_ingestion_status")
  @@index([fileHash], name: "idx_documents_file_hash")
  @@unique([wellId, fileHash], map: "uq_well_document_file_hash")
  @@map("documents")
}

