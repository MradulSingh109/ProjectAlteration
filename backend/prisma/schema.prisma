// SIH26034 Legal Metrology Compliance Engine Prisma Schema
// PostgreSQL Database Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum RoleCode {
  ADMIN
  INSPECTOR
  REVIEWER
}

enum WorkflowStatus {
  DRAFT
  PROCESSING
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum ComplianceStatus {
  PASS
  FAIL
  REVIEW
}

enum ImageType {
  FRONT
  BACK
  SIDE
  TOP
  BOTTOM
  OTHER
}

enum OCRProcessingStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DeclarationSource {
  OCR
  AI
  MANUAL
}

enum DeclarationType {
  MRP
  NET_QUANTITY
  MFG_DATE
  EXP_DATE
  CONSUMER_CARE
  COUNTRY_OF_ORIGIN
  COMMODITY_NAME
  MFG_ADDRESS
  IMPORTER_DETAILS
}

enum ValidationStatus {
  PASS
  FAIL
  REVIEW
  NOT_APPLICABLE
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ViolationStatus {
  OPEN
  CONFIRMED
  DISMISSED
  RESOLVED
}

enum EvidenceType {
  IMAGE
  OCR_TEXT
  DECLARATION
  BOUNDING_BOX
}

enum ReportType {
  FULL_COMPLIANCE
  VIOLATION_SUMMARY
}

// ==========================================
// 1. AUTHENTICATION & USER MANAGEMENT
// ==========================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  roleId       String   @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  role             Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  inspections      Inspection[] @relation("UserInspections")
  generatedReports Report[]     @relation("UserReports")
  auditLogs        AuditLog[]   @relation("UserAuditLogs")

  @@index([roleId])
  @@map("users")
}

// ==========================================
// 2. PRODUCTS & CATEGORIES
// ==========================================

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  description String?
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  products              Product[]
  ruleVersionCategories RuleVersionCategory[]

  @@map("product_categories")
}

model Product {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  brandName        String
  manufacturerName String
  categoryId       String    @db.Uuid
  description      String?
  deletedAt        DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inspections Inspection[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// ==========================================
// 3. INSPECTION & IMAGE PIPELINE
// ==========================================

model Inspection {
  id               String           @id @default(uuid()) @db.Uuid
  inspectionNumber String           @unique
  productId        String           @db.Uuid
  createdBy        String           @db.Uuid
  workflowStatus   WorkflowStatus   @default(DRAFT)
  complianceStatus ComplianceStatus @default(REVIEW)
  remarks          String?
  inspectedAt      DateTime         @default(now()) @db.Timestamptz
  completedAt      DateTime?        @db.Timestamptz
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator           User               @relation("UserInspections", fields: [createdBy], references: [id], onDelete: Restrict)
  images            InspectionImage[]
  declarations      Declaration[]
  validationResults ValidationResult[]
  violations        Violation[]
  reports           Report[]

  @@index([productId])
  @@index([createdBy])
  @@index([workflowStatus])
  @@index([complianceStatus])
  @@index([inspectedAt])
  @@index([createdAt])
  @@map("inspections")
}

model InspectionImage {
  id               String    @id @default(uuid()) @db.Uuid
  inspectionId     String    @db.Uuid
  fileUrl          String
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  imageType        ImageType @default(OTHER)
  uploadedAt       DateTime  @default(now()) @db.Timestamptz

  inspection   Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  ocrResults   OCRResult[]
  declarations Declaration[] @relation("SourceImageDeclarations")
  evidences    Evidence[]

  @@index([inspectionId])
  @@map("inspection_images")
}

model OCRResult {
  id                String              @id @default(uuid()) @db.Uuid
  inspectionImageId String              @db.Uuid
  provider          String              @default("paddleocr")
  rawText           String
  confidence        Float
  language          String              @default("en")
  boundingBoxes     Json?
  processingStatus  OCRProcessingStatus @default(PENDING)
  createdAt         DateTime            @default(now()) @db.Timestamptz

  image     InspectionImage @relation(fields: [inspectionImageId], references: [id], onDelete: Restrict)
  evidences Evidence[]

  @@index([inspectionImageId])
  @@map("ocr_results")
}

// ==========================================
// 4. EXTRACTED DECLARATIONS
// ==========================================

model Declaration {
  id              String            @id @default(uuid()) @db.Uuid
  inspectionId    String            @db.Uuid
  type            DeclarationType
  source          DeclarationSource @default(OCR)
  rawValue        String
  normalizedValue String?
  confidence      Float?
  sourceImageId   String?           @db.Uuid
  isHumanReviewed Boolean           @default(false)
  correctedValue  String?
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  inspection  Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  sourceImage InspectionImage? @relation("SourceImageDeclarations", fields: [sourceImageId], references: [id], onDelete: SetNull)
  evidences   Evidence[]

  @@index([inspectionId])
  @@index([type])
  @@map("declarations")
}

// ==========================================
// 5. VERSIONED LEGAL RULE ENGINE & APPLICABILITY
// ==========================================

model Rule {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  versions RuleVersion[]

  @@map("rules")
}

model RuleVersion {
  id             String    @id @default(uuid()) @db.Uuid
  ruleId         String    @db.Uuid
  version        Int
  effectiveFrom  DateTime  @db.Timestamptz
  effectiveTo    DateTime? @db.Timestamptz
  requirement    String
  validationType String
  configuration  Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  rule                  Rule                  @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ruleVersionCategories RuleVersionCategory[]
  validationResults     ValidationResult[]

  @@unique([ruleId, version])
  @@index([ruleId])
  @@index([effectiveFrom])
  @@map("rule_versions")
}

model RuleVersionCategory {
  id            String   @id @default(uuid()) @db.Uuid
  ruleVersionId String   @db.Uuid
  categoryId    String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz

  ruleVersion RuleVersion     @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([ruleVersionId, categoryId])
  @@index([ruleVersionId])
  @@index([categoryId])
  @@map("rule_version_categories")
}

// ==========================================
// 6. VALIDATION RESULTS & VIOLATIONS
// ==========================================

model ValidationResult {
  id            String           @id @default(uuid()) @db.Uuid
  inspectionId  String           @db.Uuid
  ruleVersionId String           @db.Uuid
  status        ValidationStatus
  message       String
  confidence    Float?
  evaluatedAt   DateTime         @default(now()) @db.Timestamptz

  inspection  Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  violations  Violation[]

  @@index([inspectionId])
  @@index([ruleVersionId])
  @@index([status])
  @@map("validation_results")
}

model Violation {
  id                 String            @id @default(uuid()) @db.Uuid
  inspectionId       String            @db.Uuid
  validationResultId String            @db.Uuid
  code               String
  severity           ViolationSeverity @default(MEDIUM)
  title              String
  description        String
  status             ViolationStatus   @default(OPEN)
  createdAt          DateTime          @default(now()) @db.Timestamptz
  resolvedAt         DateTime?         @db.Timestamptz

  inspection       Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  validationResult ValidationResult @relation(fields: [validationResultId], references: [id], onDelete: Restrict)
  evidences        Evidence[]

  @@index([inspectionId])
  @@index([validationResultId])
  @@index([status])
  @@map("violations")
}

model Evidence {
  id            String       @id @default(uuid()) @db.Uuid
  violationId   String       @db.Uuid
  imageId       String?      @db.Uuid
  ocrResultId   String?      @db.Uuid
  declarationId String?      @db.Uuid
  type          EvidenceType
  referenceId   String?
  metadata      Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz

  violation   Violation        @relation(fields: [violationId], references: [id], onDelete: Restrict)
  image       InspectionImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  ocrResult   OCRResult?       @relation(fields: [ocrResultId], references: [id], onDelete: SetNull)
  declaration Declaration?     @relation(fields: [declarationId], references: [id], onDelete: SetNull)

  @@index([violationId])
  @@index([imageId])
  @@index([ocrResultId])
  @@index([declarationId])
  @@map("evidences")
}

// ==========================================
// 7. REPORTS & AUDIT LOGGING
// ==========================================

model Report {
  id           String     @id @default(uuid()) @db.Uuid
  inspectionId String     @db.Uuid
  fileUrl      String
  storageKey   String
  reportType   ReportType @default(FULL_COMPLIANCE)
  generatedBy  String     @db.Uuid
  generatedAt  DateTime   @default(now()) @db.Timestamptz

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  generator  User       @relation("UserReports", fields: [generatedBy], references: [id], onDelete: Restrict)

  @@index([inspectionId])
  @@index([generatedBy])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
